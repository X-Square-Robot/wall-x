# Copy to local/env.sh and edit paths for your machine:
#   cp env.example local/env.sh
#
# CONDA_ENV can be an environment name (wallx) or a full prefix path.

export CONDA_SH="/path/to/miniforge3/etc/profile.d/conda.sh"
export CONDA_ENV="wallx"
export LEROBOT_DIR="/path/to/lerobot"
export CHECKPOINT_PATH="/path/to/checkpoint"
export PORT="${PORT:-44660}"
export CUDA_ID="${CUDA_ID:-0}"
